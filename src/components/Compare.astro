---
// Drag (or use the arrow keys) to compare two layers of the same island.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { a: ImageMetadata; b: ImageMetadata; la: string; lb: string; label: string }
const { a, b, la, lb, label } = Astro.props;
---
<div class="compare" data-compare>
  <Image src={a} alt={la} widths={[640, 1000, 1400]} sizes="(max-width: 1320px) 100vw, 1320px" formats={['webp']} loading="lazy" />
  <div class="after"><Image src={b} alt={lb} widths={[640, 1000, 1400]} sizes="(max-width: 1320px) 100vw, 1320px" formats={['webp']} loading="lazy" /></div>
  <input type="range" min="0" max="100" value="50" step="1" aria-label={label} />
  <div class="handle"></div>
</div>
<div class="compare-labels" aria-hidden="true"><span>← {la}</span><span>Drag or use the arrow keys</span><span>{lb} →</span></div>
