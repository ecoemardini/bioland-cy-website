---
// EU and Republic of Cyprus emblems on a light ground, first thing on every page, so they are visible without scrolling
// on desktop and on phones (CPR Annex IX 1.1; EC Support Kit 6.1). The EU emblem is kept at least as wide as the BIOLAND-Cy logo below it.
import site from '../data/site.json';
---
<div class="a-top" role="complementary" aria-label="Funding">
  <div class="fstrip">
    <img src="/brand/funders/EN_Co-fundedbytheEU_RGB_POS.svg" alt="Co-funded by the European Union" width="296" height="66" />
    <img src="/brand/funders/Cyprus_Republic_logo_EN.svg" alt="Republic of Cyprus" width="83" height="66" />
    <p>THALIA 2021–2027<br />{site.project_code}</p>
  </div>
</div>
