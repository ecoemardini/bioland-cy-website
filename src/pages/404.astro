---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section on-dark" style="min-height:60vh;display:grid;align-items:center">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 style="color:#fff;font-size:var(--step-4);max-width:18ch">This part of the map is still blank</h1>
      <p class="lead" style="color:#c9d2e1">The page you were looking for does not exist or has moved.</p>
      <p class="btn-row"><a class="btn" href="/">Back to the home page</a><a class="btn btn-ghost" href="/news">Latest news</a></p>
    </div>
  </section>
</Base>
