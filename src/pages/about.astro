---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Figure from '../components/Figure.astro';
import { IMG, COPERNICUS } from '../data/images';
import site from '../data/site.json';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const initials = (n: string) => n.replace(/^Dr\.?\s+/, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
<Base title="About and team" description="The BIOLAND-Cy team, the ERATOSTHENES Centre of Excellence that runs the project, and its funding: co-funded by the European Union under THALIA 2021–2027 through the Research and Innovation Foundation.">
  <PageHead eyebrow="About & team" n="§05" title="Who we are" lead="The people who run BIOLAND-Cy, the Centre that hosts it and how the project is funded." />

  <section class="section-tight" id="team" style="padding-top:0;scroll-margin-top:calc(var(--header-h) + 24px)" aria-labelledby="team-h">
    <div class="wrap">
      <p class="eyebrow">People</p>
      <h2 id="team-h">The team</h2>
      <div class="grid g3" style="margin-top:28px">
        {team.map((p) => (
          <article class="card">
            <div class:list={['avatar', p.data.photo && 'has-photo']}>{p.data.photo ? <Image src={p.data.photo} alt={`Portrait of ${p.data.name}`} widths={[360, 720]} sizes="(max-width: 640px) 90vw, 400px" /> : <span aria-hidden="true">{initials(p.data.name)}</span>}</div>
            <h3 style="margin-bottom:4px">{p.data.name}</h3>
            <p class="meta" style="margin:0 0 12px">{p.data.role}</p>
            {p.data.bio && <p class="muted">{p.data.bio}</p>}
            <p class="small" style="margin:0">
              {p.data.email && <a href={`mailto:${p.data.email}`} style="margin-right:14px">E-mail</a>}
              {p.data.orcid && <a href={`https://orcid.org/${p.data.orcid}`} style="margin-right:14px">ORCID</a>}
              {p.data.linkedin && <a href={p.data.linkedin}>LinkedIn</a>}
            </p>
          </article>
        ))}
      </div>
      <p style="margin-top:28px"><a class="textlink" href="/research">Research &amp; objectives <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section-tight" style="background:var(--surface-2)" aria-labelledby="ecoe-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Host institution</p>
        <h2 id="ecoe-h" style="font-size:var(--step-3)">ERATOSTHENES Centre of Excellence</h2>
        <p>The ERATOSTHENES Centre of Excellence in Limassol is Cyprus's Centre of Excellence for Earth Observation, geospatial analysis and space-based environmental monitoring. Its Cultural Heritage Cluster brings together satellite Earth Observation, geospatial analysis and landscape archaeology, with long experience of Copernicus-based monitoring of cultural landscapes. BIOLAND-Cy is the Centre's first bioarchaeology project.</p>
        <p><a class="textlink" href="https://eratosthenes.org.cy" rel="noopener">eratosthenes.org.cy <span aria-hidden="true">↗</span></a></p>
      </div>
      <Figure pic={IMG.lab} ratio="16 / 10" />
    </div>
  </section>

  <section class="section-tight" aria-labelledby="fund-h">
    <div class="wrap-narrow">
      <div class="card" id="funding" style="scroll-margin-top:calc(var(--header-h) + 24px)">
        <p class="eyebrow">Funding</p>
        <h2 id="fund-h" class="visually-hidden">Funding</h2>
        <img src="/brand/funders/EN_Co-fundedbytheEU_RGB_NEG.svg" alt="Co-funded by the European Union" width="260" height="58" style="height:58px;width:auto;margin-bottom:14px" />
        <p>{site.funding_en}</p>
        <p lang="el">{site.funding_el}</p>
        <dl style="display:grid;grid-template-columns:auto 1fr;gap:6px 18px;margin:18px 0 0" class="small">
          <dt class="muted">Project</dt><dd style="margin:0">{site.project_code}</dd>
          <dt class="muted">Duration</dt><dd style="margin:0">24 months, 1 July 2026 – 30 June 2028</dd>
          <dt class="muted">Implemented by</dt><dd style="margin:0">ERATOSTHENES Centre of Excellence, Limassol</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="image-credits" style="background:var(--surface-2)" aria-labelledby="cr-h">
    <div class="wrap-narrow prose">
      <h2 id="cr-h" style="font-size:var(--step-3)">Image credits</h2>
      <p><strong>Satellite maps and 3D views</strong> are real data. {COPERNICUS} Sentinel-1 coherence: Kellndorfer et al. 2022, Global Seasonal Sentinel-1 Interferometric Coherence (CC BY 4.0). Lakes: JRC Global Surface Water. Maps and 3D views: BIOLAND-Cy / ERATOSTHENES Centre of Excellence.</p>
      <p><strong>Pictures captioned “AI-generated image”</strong> are AI-generated illustrations, made for BIOLAND-Cy and checked against published evidence. Reconstructions of the past are interpretations, and the people in them are fictional. They are not photographs of real places or people.</p>
      <p><strong>Event photographs</strong>: ERATOSTHENES Centre of Excellence.</p>
    </div>
  </section>
</Base>
