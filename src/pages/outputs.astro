---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Timeline from '../components/Timeline.astro';
import { getDeliverables, STATUS, WPS, monthDate, currentMonth } from '../lib/content';
const all = await getDeliverables();
const pub = all.filter((d) => d.data.public && (d.data.pdf || d.data.doi));
const m = currentMonth();
const doiUrl = (d: string) => (d.startsWith('http') ? d : `https://doi.org/${d}`);
---
<Base title="Outputs & data" description="BIOLAND-Cy deliverables, open datasets, code and publications, with their status and downloads.">
  <PageHead eyebrow="Outputs & data" n="§02" title="Outputs, data and code"
    lead="Everything BIOLAND-Cy produces is planned to be open: datasets under CC BY 4.0 with DOIs, code under the MIT licence and open-access papers. This page lists every deliverable and its status." />

  <section class="section-tight navy-field" aria-labelledby="tl-h">
    <div class="wrap">
      <p class="eyebrow" id="tl-h">Progress · 24 months</p>
      <Timeline />
    </div>
  </section>

  <section class="section-tight" aria-labelledby="dl-h">
    <div class="wrap">
      <h2 id="dl-h" style="font-size:var(--step-3)">Available for download</h2>
      {pub.length === 0 ? (
        <div class="card" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
          <span class="tag planned">Nothing public yet</span>
          <p style="margin:0" class="muted">The first public items are expected from month 6 (December 2026). Subscribe to the <a href="/contact#newsletter">newsletter</a> to hear when they are released.</p>
        </div>
      ) : (
        <div class="grid g3">
          {pub.map((d) => (
            <article class="card link-card">
              <span class="tag published">{d.data.code}</span>
              <h3 style="margin-top:12px">{d.data.title}</h3>
              {d.data.summary && <p class="muted">{d.data.summary}</p>}
              <p class="btn-row" style="margin:0">
                {d.data.pdf && <a class="btn" href={d.data.pdf} download>Download PDF</a>}
                {d.data.doi && <a class="btn btn-ghost" href={doiUrl(d.data.doi)}>DOI</a>}
              </p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section-tight" aria-labelledby="all-h">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:16px;margin-bottom:18px">
        <h2 id="all-h" style="font-size:var(--step-3);margin:0">All deliverables</h2>
        <div class="btn-row" role="group" aria-label="Filter by work package" data-filter>
          <button class="chip-link" type="button" aria-pressed="true" data-wp="all">All</button>
          {WPS.map((w) => <button class="chip-link" type="button" aria-pressed="false" data-wp={w.id}>{w.id}</button>)}
        </div>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="All deliverables (scrollable table)">
        <table>
          <caption class="visually-hidden">All BIOLAND-Cy deliverables with work package, due month and status</caption>
          <thead><tr><th scope="col">Code</th><th scope="col">Deliverable</th><th scope="col">WP</th><th scope="col">Due</th><th scope="col">Status</th><th scope="col">Access</th></tr></thead>
          <tbody>
            {all.map((d) => (
              <tr data-row={d.data.wp}>
                <td><strong>{d.data.code}</strong></td>
                <td>{d.data.title}{d.data.summary && <><br /><span class="muted small">{d.data.summary}</span></>}</td>
                <td>{d.data.wp}</td>
                <td style="white-space:nowrap">M{d.data.due_month} · {monthDate(d.data.due_month)}{d.data.status === 'planned' && d.data.due_month < m && <span class="visually-hidden"> (due date passed)</span>}</td>
                <td><span class:list={['tag', d.data.status]}>{STATUS[d.data.status]}</span></td>
                <td>{d.data.pdf ? <a href={d.data.pdf}>PDF</a> : d.data.doi ? <a href={doiUrl(d.data.doi)}>DOI</a> : <span class="muted">—</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="open-h">
    <div class="wrap">
      <h2 id="open-h" style="font-size:var(--step-3)">Open data, code and papers</h2>
      <div class="grid g3" style="margin-top:20px">
        <article class="card"><span class="tag planned">From M6</span><h3 style="margin-top:12px">Datasets on Zenodo</h3><p class="muted">Five FAIR geospatial datasets, published under CC BY 4.0 in a BIOLAND-Cy community on Zenodo as they are released, each with a DOI.</p></article>
        <article class="card"><span class="tag planned">From project end</span><h3 style="margin-top:12px">Code on GitHub</h3><p class="muted">Reproducible processing pipelines released under the MIT licence.</p></article>
        <article class="card"><span class="tag planned">M24</span><h3 style="margin-top:12px">Open-access papers</h3><p class="muted">Peer-reviewed publications and conference papers presenting the methods, the indices and the GeoHub.</p></article>
      </div>
    </div>
  </section>
  <script>
    const g = document.querySelector('[data-filter]');
    g?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      const wp = b.dataset.wp;
      g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => { r.hidden = wp !== 'all' && r.dataset.row !== wp; });
    });
  </script>
</Base>
